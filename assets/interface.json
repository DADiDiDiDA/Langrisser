{
    "interface_version": 2,
    "name": "Langrisser",
    "description": "梦幻模拟战自动日常脚本",
    "license": "MIT",
    "welcome": "欢迎使用梦幻模拟战自动化脚本！",
    "version": "0.1.0",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "梦幻模拟战",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        },
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": ["./resource"]
        }
    ],
    "task": [
        {
            "name": "开始游戏",
            "entry": "返回主界面开始",
            "default_check": true,
            "doc": "从任意界面返回游戏主界面"
        },
        {
            "name": "领取邮件",
            "entry": "领取邮件开始",
            "default_check": true,
            "doc": "自动领取邮箱中的所有邮件"
        },
        {
            "name": "领取浮空之境",
            "entry": "浮空之境资源开始",
            "default_check": true,
            "doc": "自动领取浮空之境资源"
        },
        {
            "name": "友情点领取",
            "entry": "友情点领取开始",
            "default_check": true,
            "doc": "赠送好友友情点并领取友情点奖励"
        },
        {
            "name": "商店购买",
            "entry": "商店购买开始",
            "default_check": true,
            "doc": "自动购买商店中的友情券"
        },
        {
            "name": "竞技场",
            "entry": "竞技场开始",
            "default_check": true,
            "doc": "执行一次竞技场快速作战挑战"
        },
        {
            "name": "完成世界事件",
            "entry": "完成世界事件开始",
            "default_check": true,
            "doc": "完成当前可用的世界事件"
        },
        {
            "name": "完成碎片扫荡",
            "entry": "羁绊开始",
            "default_check": true,
            "doc": "完成每日的碎片扫荡"
        },
        {
            "name": "刷体力-兄贵健身房",
            "entry": "刷体力开始",
            "default_check": true,
            "option": ["刷体力-兄贵健身房"],
            "doc": "刷兄贵健身房体力，支持扫荡和连续作战"
        },
        {
            "name": "刷体力-安杰丽卡特训屋",
            "entry": "刷体力开始",
            "default_check": true,
            "option": ["刷体力-安杰丽卡特训屋"],
            "doc": "刷安杰丽卡特训屋体力，支持扫荡和连续作战"
        },
        {
            "name": "刷体力-女神的试炼",
            "entry": "刷体力开始",
            "default_check": true,
            "option": ["刷体力-女神的试炼"],
            "doc": "刷女神的试炼体力，支持扫荡和连续作战"
        },
        {
            "name": "领取任务奖励（第一次）",
            "entry": "领取任务奖励开始",
            "default_check": true,
            "doc": "自动领取每日任务的奖励"
        },
        {
            "name": "刷体力-羁绊之地",
            "entry": "刷体力开始",
            "default_check": true,
            "option": ["刷体力-羁绊之地"],
            "doc": "刷羁绊之地体力，支持扫荡和连续作战"
        },
        {
            "name": "刷体力-律定之途",
            "entry": "刷体力开始",
            "default_check": true,
            "option": ["刷体力-律定之途"],
            "doc": "刷律定之途体力，支持扫荡和连续作战"
        },
        {
            "name": "友情池召唤一次",
            "entry": "友情池召唤一次开始",
            "default_check": true,
            "doc": "使用友情券进行一次友情池召唤"
        },
        {
            "name": "领取任务奖励（第二次）",
            "entry": "领取任务奖励开始",
            "default_check": true,
            "doc": "自动领取每日任务的奖励"
        }
    ],
    "option": {
        "刷体力-兄贵健身房": {
            "type": "select",
            "label": "副本类型",
            "default_case": "兄贵健身房",
            "cases": [
                {
                    "name": "兄贵健身房",
                    "label": "兄贵健身房",
                    "option": ["刷体力-选择完成方式"],
                    "pipeline_override": {
                        "开始选择打什么类型": {
                            "next": ["兄贵健身房", "[JumpBack]滑动关卡列表"]
                        }
                    }
                }
            ]
        },
        "刷体力-安杰丽卡特训屋": {
            "type": "select",
            "label": "副本类型",
            "default_case": "安杰丽卡特训屋",
            "cases": [
                {
                    "name": "安杰丽卡特训屋",
                    "label": "安杰丽卡特训屋",
                    "option": ["刷体力-选择完成方式"],
                    "pipeline_override": {
                        "开始选择打什么类型": {
                            "next": ["安杰丽卡特训屋", "[JumpBack]滑动关卡列表"]
                        }
                    }
                }
            ]
        },
        "刷体力-女神的试炼": {
            "type": "select",
            "label": "副本类型",
            "default_case": "女神的试炼",
            "cases": [
                {
                    "name": "女神的试炼",
                    "label": "女神的试炼",
                    "option": ["刷体力-选择完成方式"],
                    "pipeline_override": {
                        "开始选择打什么类型": {
                            "next": ["女神的试炼", "[JumpBack]滑动关卡列表"]
                        }
                    }
                }
            ]
        },
        "刷体力-羁绊之地": {
            "type": "select",
            "label": "副本类型",
            "default_case": "羁绊之地",
            "cases": [
                {
                    "name": "羁绊之地",
                    "label": "羁绊之地",
                    "option": ["刷体力-选择完成方式"],
                    "pipeline_override": {
                        "开始选择打什么类型": {
                            "next": ["羁绊之地", "[JumpBack]滑动关卡列表"]
                        }
                    }
                }
            ]
        },
        "刷体力-律定之途": {
            "type": "select",
            "label": "副本类型",
            "default_case": "律定之途",
            "cases": [
                {
                    "name": "律定之途",
                    "label": "律定之途",
                    "option": ["刷体力-选择完成方式"],
                    "pipeline_override": {
                        "开始选择打什么类型": {
                            "next": ["律定之途", "[JumpBack]滑动关卡列表"]
                        }
                    }
                }
            ]
        },
        "刷体力-选择完成方式": {
            "type": "select",
            "label": "选择完成关卡方式",
            "default_case": "扫荡",
            "cases": [
                {
                    "name": "扫荡",
                    "label": "扫荡",
                    "pipeline_override": {
                        "开始选择完成关卡方式-四个类型": {
                            "next": ["选择扫荡方式-前三个类型"]
                        }
                    }
                },
                {
                    "name": "连续作战",
                    "label": "连续作战",
                    "pipeline_override": {
                        "开始选择完成关卡方式-四个类型": {
                            "next": ["选择连续作战方式-前三个类型"]
                        }
                    }
                }
            ]
        }
    }
}